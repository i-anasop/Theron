# FortyGuard Temperature API — key from dashboard.fortyguard.com (Profile tab)
FORTYGUARD_API_KEY=

# ---------------------------------------------------------------------------
# Reasoning provider — set ONE. All three have a free tier with no card.
# Theron speaks the OpenAI-compatible chat-completions shape, so any of these
# (or any other compatible endpoint) drives the same agent loop.
# ---------------------------------------------------------------------------

# Recommended. Free key, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Alternative. Free key, no card: https://console.groq.com/keys
GROQ_API_KEY=

# Alternative. Free models available: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override the model for whichever provider is set above
# LLM_MODEL=gemini-2.5-flash

# Optional: any other OpenAI-compatible endpoint
# LLM_BASE_URL=
# LLM_API_KEY=

# ---------------------------------------------------------------------------
# Deployment (optional locally — the app falls back to a disk cache)
# ---------------------------------------------------------------------------

# Upstash Redis, so cron ticks and requests share state in production
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Slack incoming webhook for threshold alerts
SLACK_WEBHOOK_URL=

# Shared secret so only Vercel Cron can trigger the agent tick
CRON_SECRET=
